                  "CIS Controls v8 Control 11"
                ]
              },
              "shortDescription": {
                "text": "RDS automated backups disabled"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A hardcoded UID 0 runs as root even when a policy sets runAsNonRoot, amplifying any container escape."
              },
              "help": {
                "text": "securityContext:\n  runAsUser: 1000\n  runAsNonRoot: true"
              },
              "id": "TL026",
              "name": "Container or pod runs as root by UID",
              "properties": {
                "cis": [
                  "CIS Controls v8 Control 4"
                ],
                "cwe": [
                  "CWE-250"
                ],
                "security-severity": "8.0",
                "tags": [
                  "CWE-250",
                  "CIS Controls v8 Control 4"
                ]
              },
              "shortDescription": {
                "text": "Container or pod runs as root by UID"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Host mounts and shared host namespaces give a compromised pod a direct path to read host files or other processes and escape to the node."
              },
              "help": {
                "text": "Remove hostPath volumes and hostPID/hostIPC; use a PersistentVolumeClaim or emptyDir instead."
              },
              "id": "TL027",
              "name": "Pod mounts the host filesystem or namespaces",
              "properties": {
                "cis": [
                  "CIS Controls v8 Control 4"
                ],
                "cwe": [
                  "CWE-668"
                ],
                "security-severity": "8.0",
                "tags": [
                  "CWE-668",
                  "CIS Controls v8 Control 4"
                ]
              },
              "shortDescription": {
                "text": "Pod mounts the host filesystem or namespaces"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A mutable branch ref runs whatever code that branch holds at run time; if the action is compromised or retargeted, it executes in your workflow with its secrets."
              },
              "help": {
                "text": "uses: owner/action@<40-char commit SHA>  # or at least a version tag"
              },
              "id": "TL028",
              "name": "Action pinned to a mutable branch",
              "properties": {
                "cis": [
                  "CIS Controls v8 Control 16"
                ],
                "cwe": [
                  "CWE-829"
                ],
                "security-severity": "8.0",
                "tags": [
                  "CWE-829",
                  "CIS Controls v8 Control 16"
                ]
              },
              "shortDescription": {
                "text": "Action pinned to a mutable branch"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "A container that starts as root turns any application compromise into root inside the container and a far stronger position for runtime or kernel escapes; build stages routinely need root, so only the final image's effective user matters."
              },
              "help": {
                "text": "RUN adduser -S app && ...\nUSER app  # in the final stage; root in builder stages is fine"
              },
              "id": "TL029",
              "name": "Final image runs as root",
              "properties": {
                "cis": [
                  "CIS Controls v8 Control 4"
                ],
                "cwe": [
                  "CWE-250"
                ],
                "security-severity": "8.0",
                "tags": [
                  "CWE-250",
                  "CIS Controls v8 Control 4"
                ]
              },
              "shortDescription": {
                "text": "Final image runs as root"
              }
            },
            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "ENV values persist in the image configuration and its layer history, so a baked secret ships to every registry and host that pulls the image - even when a later instruction overwrites the variable."
              },
              "help": {
                "text": "Pass secrets at runtime (orchestrator secret, --env-file) or use a BuildKit secret mount: RUN --mount=type=secret,id=token ..."
              },
              "id": "TL030",
              "name": "Secret baked into the final image environment",
              "properties": {
                "cis": [
                  "CIS Controls v8 Control 3"
                ],
                "cwe": [
                  "CWE-798"
                ],
                "security-severity": "8.0",
                "tags": [
                  "CWE-798",
                  "CIS Controls v8 Control 3"
                ]
              },
              "shortDescription": {
                "text": "Secret baked into the final image environment"
              }
            },
            {
              "defaultConfiguration": {
                "level": "note"
              },
              "fullDescription": {
                "text": "A mutable tag silently pulls whatever it points to next, so a compromised or breaking base lands in the shipped image with no diff to review and no way to reproduce yesterday's build."
              },
              "help": {
                "text": "FROM python:3.12.5-slim  # pin a version tag, or better an @sha256: digest"
              },
              "id": "TL031",
              "name": "Final image built from a mutable base tag",
              "properties": {
                "cis": [
                  "CIS Controls v8 Control 4"
                ],
                "cwe": [
                  "CWE-1104"
                ],
                "security-severity": "3.0",
                "tags": [
                  "CWE-1104",
                  "CIS Controls v8 Control 4"
                ]
              },
              "shortDescription": {
                "text": "Final image built from a mutable base tag"
              }
            },
            {
              "defaultConfiguration": {
                "level": "warning"
              },
              "fullDescription": {
                "text": "Serving SSH from inside a container widens the attack surface and bypasses the orchestrator's access and audit model; CIS Docker guidance is not to run sshd in containers."
              },
              "help": {
                "text": "Remove EXPOSE 22 and use docker exec / kubectl exec for debugging instead of SSH."
              },
              "id": "TL032",
              "name": "Final image exposes the SSH port",
              "properties": {
                "cis": [
                  "CIS Controls v8 Control 4"
                ],
                "cwe": [
                  "CWE-284"
                ],
                "security-severity": "5.0",
                "tags": [
                  "CWE-284",
                  "CIS Controls v8 Control 4"
                ]
              },
              "shortDescription": {
                "text": "Final image exposes the SSH port"
              }
            }
          ],
          "version": "1.2.0"
        }
      }
    }
  ],
  "version": "2.1.0"
}
