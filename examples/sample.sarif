            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Without the account/bucket public access block, a single ACL or policy mistake can make data public."
              },
              "help": {
                "text": "resource \"aws_s3_bucket_public_access_block\" \"this\" {\n  block_public_acls       = true\n  block_public_policy     = true\n  ignore_public_acls      = true\n  restrict_public_buckets = true\n}"
              },
