            {
              "defaultConfiguration": {
                "level": "error"
              },
              "fullDescription": {
                "text": "Public bucket ACLs expose every object to anonymous readers and are a leading cause of data leaks."
              },
              "help": {
                "text": "acl = \"private\""
              },
